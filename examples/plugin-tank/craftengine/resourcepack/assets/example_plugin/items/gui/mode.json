{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "both",
        "model": {
          "type": "minecraft:model",
          "model": "example_plugin:gui/mode_both"
        }
      },
      {
        "when": "fill",
        "model": {
          "type": "minecraft:model",
          "model": "example_plugin:gui/mode_fill"
        }
      },
      {
        "when": "empty",
        "model": {
          "type": "minecraft:model",
          "model": "example_plugin:gui/mode_empty"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "example_plugin:gui/mode_both"
    }
  }
}
